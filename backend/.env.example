# ===== 应用基础 =====
APP_NAME=AI新闻助手
DEBUG=true

# ===== 数据库（SQLite，零配置；首次运行先执行 backend/scripts/init_db.py） =====
DATABASE_URL=sqlite+aiosqlite:///./data/news.db

# ===== LLM（OpenAI 兼容接口，如 DeepSeek / DashScope / OpenAI） =====
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=deepseek-chat

# ===== 本地嵌入/重排模型 =====
# 方式一：下载到本项目 backend/models/（先运行 backend/scripts/download_models.py）
#   EMBEDDING_MODEL=BAAI/bge-m3
# 方式二：复用已有项目已下载的模型（例如 ai电商选品助手/backend/models/），
#   直接填绝对路径即可免去重复下载：
#   EMBEDDING_MODEL=D:/path/to/ai电商选品助手/backend/models/BAAI/bge-m3
EMBEDDING_MODEL=models/BAAI/bge-m3
RERANKER_MODEL=models/BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
# 重排序开关：CPU 环境较慢，可设 false 跳过 Cross-encoder 精排
RERANK_ENABLED=true

# ===== HuggingFace 镜像（国内网络可填 https://hf-mirror.com） =====
HF_ENDPOINT=https://hf-mirror.com

# ===== Agent =====
# true ：LangGraph + 真实 LLM 完整编排（需 LLM_API_KEY）
# false：规则路由 + 模板生成（无需任何 API Key，可离线演示全链路）
USE_REAL_LLM=true

# ===== 检索参数 =====
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
BM25_TOP_K=20
RRF_K=60
# 时间衰减系数：分数 = 原分 / (1 + TIME_DECAY * 距今天数)
TIME_DECAY=0.2
# 超过该天数的新闻不参与检索
MAX_NEWS_AGE_DAYS=180

# ===== 新闻源（RSS 列表，JSON 数组格式；抓取时逐源容错） =====
NEWS_SOURCES=["https://36kr.com/feed","https://sspai.com/feed","https://www.zaobao.com/rss/realtime/china","https://feeds.bbci.co.uk/zhongwen/simp/rss.xml"]
NEWS_FETCH_TIMEOUT=10

# ===== Tavily 实时搜索（可选，用于"最新消息"类问题兜底；免费额度 1000次/月） =====
# 留空则实时类问题仅走 RSS 抓取
TAVILY_API_KEY=

# ===== 定时新闻刷新（可选） =====
# 启用后每隔 N 小时自动抓取新闻源并入库
NEWS_REFRESH_ENABLED=false
NEWS_REFRESH_INTERVAL_HOURS=6
